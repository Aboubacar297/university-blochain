# ===== Serveur =====
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ===== Hyperledger Fabric (identité de l'Org1 - Université) =====
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL=diploma-channel
FABRIC_CHAINCODE=diplomacontract
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
# Fichier ou dossier (le premier fichier du dossier est utilisé)
FABRIC_CERT_PATH=../../security/certificates/org1/users/User1@org1.example.com/msp/signcerts
FABRIC_KEY_PATH=../../security/certificates/org1/users/User1@org1.example.com/msp/keystore
FABRIC_TLS_CERT_PATH=../../security/certificates/org1/peers/peer0.org1.example.com/tls/ca.crt

# ===== MinIO (stockage hors chaîne) =====
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=diplomas

# ===== Keycloak =====
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=university
# Optionnel : audience attendue dans le jeton (laisser vide pour ne pas vérifier)
KEYCLOAK_AUDIENCE=

# ===== Sécurité applicative =====
# 32 octets en hexadécimal (64 caractères) : openssl rand -hex 32
ENCRYPTION_KEY_HEX=
# Poivre pour pseudonymiser l'identifiant étudiant : openssl rand -hex 32
STUDENT_REF_PEPPER=
# Secret de signature des liens de partage : openssl rand -hex 32
SHARE_TOKEN_SECRET=
MAX_PDF_SIZE_MB=10

# ===== Développement sans réseau Fabric =====
# true : registre en mémoire (aucune connexion à Fabric). À retirer pour utiliser le vrai réseau.
FABRIC_MOCK=false

# ===== Accès étudiants (cycle de 30 jours) =====
# Compte de service Keycloak du backend (client "diploma-backend", créé par l'import du realm)
KEYCLOAK_ADMIN_CLIENT_ID=diploma-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-backend-secret-change-me
# Durée de validité d'un accès étudiant, en jours
ACCESS_WINDOW_DAYS=30
# Dossier de l'état persistant (cycle de vie des accès, compteurs)
DATA_DIR=./data
# Identifiant (URL) de l'émetteur dans les justificatifs Open Badges
ISSUER_URL=https://www.um5.ac.ma

# ===== Anti-robot Cloudflare Turnstile (clé SECRÈTE : uniquement ici, jamais dans le frontend) =====
# Valeur de test fournie par Cloudflare (accepte tout) : à remplacer par votre clé en production
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ===== Production =====
# FORCE_HTTPS=true est obligatoire en production (redirection HTTPS et HSTS)
FORCE_HTTPS=false
