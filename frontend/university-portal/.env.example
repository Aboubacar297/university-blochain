# =============================================================================
#  Portail web - variables publiques
#  ATTENTION : tout ce qui commence par VITE_ est intégré au code envoyé au navigateur.
#  N'y placez JAMAIS de secret (clé secrète Turnstile, secret Keycloak, clé de chiffrement) :
#  ces valeurs vivent uniquement dans backend/diploma-api/.env.
# =============================================================================

# URL de l'API backend (diploma-api)
VITE_API_URL=http://localhost:3000

# Keycloak (client public, PKCE S256)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=university
VITE_KEYCLOAK_CLIENT_ID=diploma-frontend

# Identité du site (liens canoniques, Open Graph, QR codes)
VITE_SITE_URL=http://localhost:5173
VITE_SITE_NAME=Registre des diplômes
VITE_INSTITUTION_NAME=Université Mohammed V de Rabat

# Adresse du délégué à la protection des données (pages légales)
VITE_PRIVACY_EMAIL=dpo@example.org

# Taille maximale d'un PDF, en Mo (doit correspondre à MAX_PDF_SIZE_MB du backend)
VITE_MAX_PDF_MB=10

# Clé PUBLIQUE Cloudflare Turnstile. Valeur de test fournie par Cloudflare (toujours valide).
# La clé SECRÈTE correspondante est dans le .env du backend.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Mesure d'audience, chargée uniquement après consentement. Laisser vide pour la désactiver.
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_SRC=https://plausible.io/js/script.js

# true tant que les pages légales n'ont pas été validées par le DPO et le service juridique
VITE_LEGAL_DRAFT=true
